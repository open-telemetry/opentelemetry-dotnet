<Project>

  <!--
    Imported into the solution build (see
    https://learn.microsoft.com/visualstudio/msbuild/customize-solution-build)
    so that the tests in a solution can be run for a single target framework
    the same way as for the aggregator .proj files in the build directory:

    dotnet build OpenTelemetry.slnx -t:Test -p:Configuration=Release -p:TargetFramework=net10.0

    This is needed because `dotnet test` (with the Microsoft.Testing.Platform
    runner configured in global.json) fails when the solution contains a test
    project which does not target the requested framework.
  -->
  <Target Name="_GetSolutionTestProjects" BeforeTargets="_GetAllTestProjectTargetFrameworks">
    <ItemGroup>
      <TestProjects Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.Tests')) OR $([System.String]::Copy('%(Filename)').EndsWith('.FuzzTests'))" />
    </ItemGroup>
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)build\Tests.targets" />

</Project>

<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>OpenTelemetry.Apple.TestApp</string>
    <key>CFBundleIdentifier</key>
    <string>io.opentelemetry.dotnet.apple</string>
    <key>CFBundleName</key>
    <string>OpenTelemetry.Apple.TestApp</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <!--
        The app has no user interface, but the supported orientations must still
        be declared for both device families otherwise the build warns that they
        have not been set.
    -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!--
        NSAllowsLocalNetworking is required because the OTLP export targets plain
        HTTP on the host loopback (http://localhost:<port>); App Transport
        Security blocks cleartext HTTP by default, which would otherwise silently
        fail the export.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>

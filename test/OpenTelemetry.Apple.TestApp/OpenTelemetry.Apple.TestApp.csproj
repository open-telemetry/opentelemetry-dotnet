<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>iOS test app validating the OpenTelemetry SDK runs end-to-end under the iOS runtime.</Description>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <NoWarn>$(NoWarn);CA1515;CA1707;CA1848;CA2007</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
  </PropertyGroup>

  <!--
    The app provides its own entry point (TestRunner.cs) so that it can write the
    results of the on-device run to a location the host test project can read
    back out of the simulator, so suppress the generated one.
  -->
  <PropertyGroup>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <!--
    Because we use project references to projects that multi-target to TFMs
    that do not support trimming we cannot publish the application as trimmed.
    iOS projects cannot set PublishTrimmed=false, so MtouchLink is used instead
    to disable trimming for all assemblies.
  -->
  <PropertyGroup>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationId>io.opentelemetry.dotnet.apple</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <EventSourceSupport>true</EventSourceSupport>
    <HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
    <MetricsSupport>true</MetricsSupport>
  </PropertyGroup>

  <!--
    The app runs its tests on the device with Microsoft.Testing.Platform rather
    than VSTest, so reference the MSTest packages it needs directly instead of
    using the MSTest meta-package, which brings in the VSTest test host as a
    transitive dependency. This matters because the arm64 iOS simulator does not
    allow JIT, so everything in the app bundle has to be AOT compiled, and the
    VSTest test host assemblies fail to AOT compile.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="MSTest.Analyzers" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <!--
    Remove the packages that are referenced by default for test projects for the
    same reason: they are not used by the on-device run and the app bundle only
    needs to contain what the tests actually require.
  -->
  <ItemGroup>
    <PackageReference Remove="GitHubActionsTestLogger" />
    <PackageReference Remove="JunitXml.TestLogger" />
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="xunit" />
    <PackageReference Remove="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(RepoRoot)\test\Shared\StrongNameTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenTelemetry\OpenTelemetry.csproj" />
    <ProjectReference Include="$(RepoRoot)\src\OpenTelemetry.Exporter.OpenTelemetryProtocol\OpenTelemetry.Exporter.OpenTelemetryProtocol.csproj" />
  </ItemGroup>

  <!--
    Each project referenced by the app copies a <Project>.BuildFlags.txt file to
    the output directory. The Apple SDK cannot determine how to treat these files
    when it computes the contents of the app bundle, so it warns about each one.
    They are not needed on the device, so remove them from the publish items.
  -->
  <Target Name="RemoveBuildFlagsFilesFromAppBundle"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::new('%(ResolvedFileToPublish.Filename)').EndsWith('.BuildFlags'))" />
    </ItemGroup>
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>End-to-end tests that drive the iOS test app on a simulator and validate the OpenTelemetry SDK under the iOS runtime by decoding the OTLP it exports.</Description>
    <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)\test\Shared\OtlpHttpCollector.cs" Link="Includes\OtlpHttpCollector.cs" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(RepoRoot)\src\Shared\Proto\**\*.proto" Link="Proto\%(RecursiveDir)%(Filename)%(Extension)" Access="internal" GrpcServices="None">
      <ProtoRoot>$(RepoRoot)\src\Shared\Proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

</Project>

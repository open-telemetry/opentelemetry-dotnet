<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unit test project for OpenTelemetry Process Context Sharing</Description>
    <TargetFrameworks>$(TargetFrameworksForTests)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)\test\OpenTelemetry.Tests\Shared\EnvVarsCollectionDefinition.cs" Link="Includes\EnvVarsCollectionDefinition.cs" />
    <Compile Include="$(RepoRoot)\test\OpenTelemetry.Tests\Shared\EventSourceCollectionDefinition.cs" Link="Includes\EventSourceCollectionDefinition.cs" />
    <Compile Include="$(RepoRoot)\test\OpenTelemetry.Tests\Shared\EventSourceTestHelper.cs" Link="Includes\EventSourceTestHelper.cs" />
    <Compile Include="$(RepoRoot)\test\OpenTelemetry.Tests\Shared\TestEventListener.cs" Link="Includes\TestEventListener.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\OpenTelemetry.Extensions.ProcessContext\OpenTelemetry.Extensions.ProcessContext.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used only to decode the payloads written by the hand-written serializer. -->
    <Protobuf Include="$(RepoRoot)\src\Shared\Proto\opentelemetry\proto\common\v1\common.proto;$(RepoRoot)\src\Shared\Proto\opentelemetry\proto\resource\v1\resource.proto;$(RepoRoot)\src\Shared\Proto\opentelemetry\proto\processcontext\v1development\process_context.proto" Link="Proto\%(RecursiveDir)%(Filename)%(Extension)" Access="internal" GrpcServices="None">
      <ProtoRoot>$(RepoRoot)\src\Shared\Proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

</Project>
